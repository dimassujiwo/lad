#!/usr/sbin/nft -f

flush ruleset

define SSH_PORT = 22
define HTTP_PORT = 80
define HTTPS_PORT = 443

table inet anti_ddos {
    set trusted_sources {
        type ipv4_addr
        flags interval
        elements = { 10.0.0.0/8, 192.168.0.0/16 }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        # Always allow established/related traffic first.
        ct state established,related accept
        ct state invalid drop

        # Local traffic.
        iif lo accept

        # ICMP/ICMPv6 are needed for correct IP behavior. Rate-limit rather than
        # blindly disabling them; tune to your network.
        ip protocol icmp limit rate 50/second burst 100 packets accept
        ip6 nexthdr icmpv6 limit rate 100/second burst 200 packets accept

        # Management example. Replace with a management CIDR in production.
        ip saddr @trusted_sources tcp dport $SSH_PORT ct state new accept

        # Public services.
        tcp dport { $HTTP_PORT, $HTTPS_PORT } ct state new accept

        # Example UDP service ports. Add only services you actually expose.
        # udp dport { 443 } accept

        # Per-source SYN pressure guard. This is intentionally a conservative
        # example; large NAT populations may need a higher value.
        tcp flags syn tcp dport { $HTTP_PORT, $HTTPS_PORT } \
            meter syn_rate { ip saddr limit rate 100/second burst 200 packets } accept

        # Log only a small sample to avoid turning a flood into a log flood.
        limit rate 5/second burst 10 packets log prefix "anti-ddos-drop " flags all
        drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
